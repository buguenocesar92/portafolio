---
interface Props { label: string }
const { label } = Astro.props;
---
<div class="fixed inset-x-0 top-0 z-50 h-[2px] pointer-events-none" aria-hidden="true" title={label}>
  <div id="scroll-progress" class="h-full origin-left scale-x-0 bg-emerald-term"></div>
</div>
<script>
  const indicator = document.getElementById('scroll-progress');
  if (indicator) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const available = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = available > 0 ? Math.min(1, Math.max(0, window.scrollY / available)) : 0;
      indicator.style.transform = `scaleX(${ratio})`;
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(update); };
    queue();
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    addEventListener('pagehide', () => { removeEventListener('scroll', queue); removeEventListener('resize', queue); cancelAnimationFrame(raf); }, { once: true });
  }
</script>
