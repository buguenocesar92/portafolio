---
interface Props { label: string; state?: 'build' | 'review' }
const { label, state = 'build' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2 rounded border px-2 py-1 font-mono text-[10px] tracking-widest uppercase', state === 'build' ? 'border-emerald-term/40 text-emerald-term' : 'border-amber-forge/40 text-amber-forge']}>
  <span class="size-1.5 rounded-full bg-current" aria-hidden="true"></span>
  <span>{label}</span>
</span>
