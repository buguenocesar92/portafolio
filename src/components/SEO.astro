---
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang?: 'es' | 'en';
  image?: string;
  type?: 'website' | 'article';
  /** Rutas alternas por idioma, p.ej. { es: '/', en: '/en/' } */
  alternates?: Partial<Record<'es' | 'en', string>>;
  publishedAt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'es',
  image = SITE.ogImage,
  type = 'website',
  alternates,
  publishedAt,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(image, Astro.site ?? SITE.url).href;
const locale = lang === 'es' ? 'es_CL' : 'en_US';

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: title,
        description,
        inLanguage: lang,
        datePublished: publishedAt,
        author: { '@type': 'Person', name: SITE.name, url: SITE.url },
        mainEntityOfPage: canonical,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: SITE.name,
        url: SITE.url,
        jobTitle: 'Senior Platform Engineer & DevSecOps Specialist',
        sameAs: SITE.linkedin ? [SITE.github, SITE.linkedin] : [SITE.github],
      };
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<meta name="author" content={SITE.name} />
<meta name="theme-color" content="#090A0F" />

{
  alternates &&
    Object.entries(alternates).map(([l, path]) => (
      <link rel="alternate" hreflang={l} href={new URL(path, Astro.site ?? SITE.url).href} />
    ))
}
{alternates?.es && <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, Astro.site ?? SITE.url).href} />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={locale} />
{publishedAt && <meta property="article:published_time" content={publishedAt} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
