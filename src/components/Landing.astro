---
import '../styles/dossier.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { dossier, type DossierLang } from '../data/dossier';
import { getCasesByLang } from '../lib/cms';
interface Props { lang: DossierLang }
const {lang}=Astro.props;
const d=dossier[lang];
const archive=await getCasesByLang(lang);
---
<BaseLayout {lang} title={d.title} description={d.description} bodyClass="dossier-page" alternates={{es:'/',en:'/en/'}}>
  <div class="dossier">
    <header class="d-header" id="top">
      <div class="d-shell d-header__inner">
        <a class="d-signature" href={lang==='es'?'/':'/en/'} aria-label="César Bugueño">
          <span class="d-signature__mark">C<span>/</span>B</span>
          <span class="d-signature__name">CÉSAR BUGUEÑO <small>SOFTWARE ENGINEER</small></span>
        </a>
        <nav class="d-nav" aria-label={d.nav.intro}>
          <a href="#work">{d.nav.work}</a><a href="#principles">{d.nav.principles}</a><a href="#experience">{d.nav.experience}</a><a href="#contact">{d.nav.contact}</a>
        </nav>
        <a class="d-language" href={lang==='es'?'/en/':'/'} hreflang={lang==='es'?'en':'es'}>{d.nav.toggle} ↗</a>
      </div>
    </header>
    <main id="main">
      <section class="d-hero" aria-labelledby="d-main-heading">
        <div class="d-shell">
          <div class="d-hero__top"><p class="d-label">{d.eyebrow}</p><p>{d.heroRole}</p></div>
          <h1 id="d-main-heading" class="d-hero__title">
            {d.heroLines.map((line,index)=><span class:list={[index===2&&'d-hero__title-accent']}>{line}</span>)}
          </h1>
          <div class="d-hero__bottom">
            <div class="d-hero__aside" aria-hidden="true"><span>✳</span> {d.heroAside}</div>
            <div class="d-hero__description">
              <p>{d.heroCopy}</p>
              <div class="d-hero__links"><a class="d-link-strong" href="#work">{d.heroLink} ↘</a><a href="#principles">{d.heroSecondary}</a></div>
            </div>
          </div>
        </div>
      </section>
      <section class="d-sheet" aria-labelledby="d-sheet-heading">
        <div class="d-shell d-sheet__inner">
          <div class="d-sheet__intro" data-reveal>
            <span class="d-label">{d.sheet.pre}</span>
            <h2 id="d-sheet-heading">{d.sheet.title}</h2>
          </div>
          <div class="d-sheet__layers" role="list">
            {d.sheet.labels.map((label,index)=>
              <div class="d-sheet__layer" role="listitem" data-reveal>
                <span>0{index+1} <i aria-hidden="true">━━</i></span><h3>{label}</h3><p>{d.sheet.captions[index]}</p>
              </div>
            )}
          </div>
          <p class="d-sheet__note">{d.sheet.foot}</p>
        </div>
      </section>
      <section id="work" class="d-work d-section" aria-labelledby="d-work-heading">
        <div class="d-shell">
          <div class="d-section__head" data-reveal>
            <p class="d-label">{d.indexLabel}</p><h2 id="d-work-heading">{d.workTitle}</h2><p>{d.workDescription}</p>
          </div>
          <div class="d-projects">
            {d.projects.map(project=>
              <article class:list={['d-project',project.emphasis&&'d-project--feature']} id={project.id}>
                <div class="d-project__heading" data-reveal>
                  <div class="d-project__meta"><span>{project.number} / 05</span><span>{project.kicker}</span><span>{project.year}</span></div>
                  <div class="d-project__body">
                    <h3>{project.title}</h3>
                    <div class="d-project__side"><p>{project.summary}</p><div class="d-project__tags">{project.technologies.slice(0,4).map(tech=><span>{tech}</span>)}</div></div>
                  </div>
                </div>
                <details class="d-project__details">
                  <summary><span>{d.projectAction}</span><span class="d-project__details-icon" aria-hidden="true">＋</span></summary>
                  <div class="d-project__expanded">
                    <div><h4>{d.projectLabels.context}</h4><p>{project.context}</p><p>{project.contribution}</p></div>
                    <div><h4>{d.projectLabels.decisions}</h4><ol>{project.decisions.map(decision=><li>{decision}</li>)}</ol></div>
                    <div class="d-project__evidence"><h4>{d.projectLabels.status}</h4><p>{project.proof}</p>
                      {project.link&&<a href={project.link.url} target="_blank" rel="noopener noreferrer">{project.link.label} ↗</a>}
                    </div>
                  </div>
                </details>
              </article>
            )}
          </div>
          <p class="d-work__disclaimer">{d.caseDisclaimer}</p>
          {archive.length>0&&<div class="d-archive">
            <p class="d-label">{lang==='es'?'ARCHIVO / DOCUMENTACIÓN':'ARCHIVE / DOCUMENTATION'}</p>
            <div>{archive.map(c=><a href={`/cases/${c.slug}/`}><span>{c.category}</span><strong>{c.title}</strong><span aria-hidden="true">↗</span></a>)}</div>
          </div>}
        </div>
      </section>
      <section class="d-principles d-section" id="principles" aria-labelledby="d-principles-heading">
        <div class="d-shell">
          <p class="d-label d-label--light">{d.principles.number}</p>
          <div class="d-principles__grid">
            <div data-reveal><p class="d-principles__eyebrow">{d.principles.label}</p><h2 id="d-principles-heading">{d.principles.title}</h2><p>{d.principles.description}</p></div>
            <ol class="d-principles__list">{d.principles.rows.map((item,index)=><li data-reveal><span>0{index+1}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></li>)}</ol>
          </div>
        </div>
      </section>
      <section class="d-experience d-section" id="experience" aria-labelledby="d-experience-heading">
        <div class="d-shell">
          <div class="d-section__head d-section__head--compact" data-reveal>
            <p class="d-label">{d.experience.number}</p><h2 id="d-experience-heading">{d.experience.title}</h2><p>{d.experience.description}</p>
          </div>
          <ol class="d-timeline">{d.experience.rows.map(job=><li data-reveal>
            <span>{job.period}</span><div><h3>{job.role}</h3><p>{job.organization}</p></div><p>{job.text}</p>
          </li>)}</ol>
        </div>
      </section>
    </main>
    <footer class="d-footer" id="contact">
      <div class="d-shell">
        <div class="d-footer__top"><p class="d-label d-label--light">04 / CONTACT</p><a href="#top">{d.footer.top} ↑</a></div>
        <h2>{d.footer.title}</h2><p class="d-footer__message">{d.footer.body}</p>
        <div class="d-footer__links">
          <a class="d-footer__primary" href="https://hefesto-studio.cl/" target="_blank" rel="noopener noreferrer">{d.footer.contact} ↗</a>
          <a href="https://github.com/buguenocesar92" target="_blank" rel="me noopener noreferrer">{d.footer.github} ↗</a>
          <a href="https://hefesto-studio.cl/" target="_blank" rel="noopener noreferrer">{d.footer.studio} ↗</a>
        </div>
        <div class="d-footer__bottom"><span>CÉSAR BUGUEÑO © {new Date().getFullYear()}</span><span>{d.footer.signature}</span></div>
      </div>
    </footer>
  </div>
</BaseLayout>
<script>
  import {mountMotion} from '../lib/motion';
  let cleanup:(()=>void)|undefined;
  const start=()=>{cleanup?.();cleanup=mountMotion();};
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',start,{once:true});
  else start();
  window.addEventListener('pagehide',()=>cleanup?.(),{once:true});
</script>
