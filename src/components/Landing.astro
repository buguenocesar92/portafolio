---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusBar from './StatusBar.astro';
import InfrastructureExperience from './infrastructure/InfrastructureExperience';
import ArchitectureDiagram from './infrastructure/ArchitectureDiagram.astro';
import CaseCard from './CaseCard.astro';
import SpotlightCard from './motion/SpotlightCard.astro';
import TerminalTyper from './motion/TerminalTyper.astro';
import MagneticButton from './motion/MagneticButton.astro';
import MarqueeTags from './motion/MarqueeTags.astro';
import ScrollProgress from './motion/ScrollProgress.astro';
import ScrambleHeading from './motion/ScrambleHeading.astro';
import { ui, blueprint, showcase, type Lang } from '../i18n/ui';
import { getCasesByLang } from '../lib/cms';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const cases = await getCasesByLang(lang);
const tags = Array.from(new Set(showcase[lang].flatMap((project) => project.chips)));
const accent = {
  amber: 'border-amber-forge/40 text-amber-forge',
  emerald: 'border-emerald-term/40 text-emerald-term',
} as const;
---
<BaseLayout lang={lang} alternates={{ es: '/', en: '/en/' }}>
  <ScrollProgress label={t.hudBuild} />
  <StatusBar {lang} />
  <main id="main" class="mx-auto max-w-6xl px-4">
    <section class="relative py-16 sm:py-28" aria-labelledby="hero-title">
      <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_50%_5%,rgba(16,185,129,.085),transparent_55%)]" aria-hidden="true"></div>
      <TerminalTyper command={t.heroCommand} />
      <h1 id="hero-title" data-split-reveal class="mt-7 max-w-5xl text-4xl leading-tight font-bold tracking-tight text-slate-50 sm:text-5xl lg:text-6xl">
        {t.h1}
      </h1>
      <p class="mt-6 max-w-3xl text-base leading-relaxed text-slate-300 sm:text-lg">{t.subtitle}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <MagneticButton href="#hefesto">[{t.ctaPrimary}]</MagneticButton>
        <MagneticButton href="#cases" variant="secondary">[{t.ctaSecondary}]</MagneticButton>
      </div>
    </section>

    <MarqueeTags tags={tags} label={t.marqueeLabel} />

    <section id="hefesto" class="scroll-mt-24 py-20" aria-labelledby="blueprint-title">
      <h2 id="blueprint-title" class="mb-6 font-mono text-sm tracking-widest text-emerald-term uppercase">
        // {t.blueprintTitle}
      </h2>
      <InfrastructureExperience client:visible layers={blueprint[lang]} title={t.blueprintTitle} hint={t.blueprintHint} schematicLabel={t.schematicLabel} />
      <div class="mt-5">
        <ArchitectureDiagram
          title={t.diagramTitle}
          description={t.diagramDescription}
          labels={t.diagramNodes}
        />
      </div>
    </section>

    <section class="pb-20" aria-labelledby="showcase-title">
      <ScrambleHeading id="showcase-title" as="h2" text={t.showcaseTitle} class="mb-6 font-mono text-sm tracking-widest text-amber-forge uppercase" />
      <div class="grid gap-4 md:grid-cols-2">
        {showcase[lang].map((s) => (
          <SpotlightCard accent={s.accent} class={s.wide ? 'md:col-span-2' : ''}>
            <p class:list={['inline-block rounded border px-2 py-0.5 font-mono text-xs', accent[s.accent]]}>{s.tag}</p>
            <h3 class="mt-4 text-xl font-semibold text-slate-100">{s.title}</h3>
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-300">{s.body}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {s.chips.map((chip) => (
                <li class="rounded border border-slate-800/80 bg-obsidian px-2 py-1 font-mono text-[11px] text-slate-300">{chip}</li>
              ))}
            </ul>
          </SpotlightCard>
        ))}
      </div>
    </section>

    <section id="cases" class="scroll-mt-24 pb-24" aria-labelledby="cases-title" data-reveal>
      <h2 id="cases-title" class="mb-6 font-mono text-sm tracking-widest text-emerald-term uppercase">// {t.casesTitle}</h2>
      {cases.length === 0 ? (
        <p class="font-mono text-sm text-slate-400">{t.casesEmpty}</p>
      ) : (
        <div class="grid gap-4 md:grid-cols-2">
          {cases.map((item) => <CaseCard case={item} lang={lang} />)}
        </div>
      )}
    </section>
  </main>
  <footer class="border-t border-slate-800/80 py-8 text-center font-mono text-xs text-slate-400">
    <p>© {new Date().getFullYear()} César Bugueño · {t.footer}</p>
  </footer>
</BaseLayout>
<script>
  import { mountMotion } from '../lib/motion';
  let cleanup: (() => void) | undefined;
  const query = matchMedia('(prefers-reduced-motion: reduce)');
  const start = () => {
    cleanup?.();
    cleanup = query.matches ? undefined : mountMotion();
  };
  const onPreferenceChange = () => start();
  const dispose = () => {
    cleanup?.();
    query.removeEventListener('change', onPreferenceChange);
    removeEventListener('pagehide', dispose);
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }
  query.addEventListener('change', onPreferenceChange);
  addEventListener('pagehide', dispose);
</script>
