---
import { SITE } from '../data/site';
import { ui, type Lang } from '../i18n/ui';
import GlitchStatusBadge from './motion/GlitchStatusBadge.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const buildSha = import.meta.env.PUBLIC_BUILD_SHA?.slice(0, 8) ?? 'local';
---
<header class="sticky top-0 z-40 border-b border-slate-800/80 bg-obsidian/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-2 font-mono text-[11px] sm:text-xs">
    <div class="flex min-w-0 flex-wrap items-center gap-3">
      <GlitchStatusBadge label={t.status} />
      <span class="hidden text-slate-500 lg:inline">{t.hudBuild}: <code>{buildSha}</code></span>
      <span class="hidden text-slate-500 md:inline">{t.hudUtc}: <time data-utc-clock>--:--:--</time></span>
    </div>
    <nav aria-label={t.navLabel} class="flex items-center gap-4 text-slate-400">
      <a class="rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-term hover:text-emerald-term" href={SITE.github} rel="me noopener noreferrer" target="_blank">GitHub</a>
      {SITE.linkedin && <a class="hover:text-emerald-term" href={SITE.linkedin} rel="me noopener noreferrer" target="_blank">LinkedIn</a>}
      <span aria-label={t.cvTodo} title={t.cvTodo} class="cursor-help text-slate-500">{t.cvLabel}: TODO</span>
      <a class="rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-term hover:text-emerald-term" href={t.altLangHref} hreflang={lang === 'es' ? 'en' : 'es'}>{t.altLangLabel}</a>
    </nav>
  </div>
</header>
<script>
  const clocks = [...document.querySelectorAll<HTMLElement>('[data-utc-clock]')];
  if (clocks.length > 0) {
    const update = () => {
      const value = new Date().toLocaleTimeString('en-GB', {
        timeZone: 'UTC', hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit',
      });
      clocks.forEach((c) => { c.textContent = value; });
    };
    update();
    const timer = window.setInterval(update, 1000);
    window.addEventListener('pagehide', () => window.clearInterval(timer), { once: true });
  }
</script>
