---
import { SITE } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---

<header class="sticky top-0 z-40 border-b border-slate-800/80 bg-obsidian/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-2 font-mono text-[11px] sm:text-xs">
    <p class="flex items-center gap-2 text-emerald-term">
      <span class="relative flex size-2" aria-hidden="true">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-term opacity-75"></span>
        <span class="relative inline-flex size-2 rounded-full bg-emerald-term"></span>
      </span>
      <span>{t.status}</span>
    </p>
    <nav aria-label="Links" class="flex items-center gap-4 text-slate-400">
      <a class="hover:text-emerald-term" href={SITE.github} rel="me noopener" target="_blank">GitHub</a>
      <a class="hover:text-emerald-term" href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      <span class="text-slate-600" aria-hidden="true">|</span>
      <span>{t.cvLabel}:</span>
      <a class="hover:text-amber-forge" href={SITE.cv.en} download>EN</a>
      <a class="hover:text-amber-forge" href={SITE.cv.es} download>ES</a>
      <span class="text-slate-600" aria-hidden="true">|</span>
      <a class="hover:text-emerald-term" href={t.altLangHref} hreflang={lang === 'es' ? 'en' : 'es'}>{t.altLangLabel}</a>
    </nav>
  </div>
</header>
